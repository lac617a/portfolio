---
import {Code} from "astro:components";
import {packages} from "../data/projects";
import {formatNumber, yearlyDownloads} from "../data/npm";

// Un ejemplo corto y real de cada librería (sacado de su README).
const snippets: Record<string, {lang: "tsx" | "jsx"; code: string}> = {
	"tailwindcss-atomic": {
		lang: "tsx",
		code: `// lo que escribes
<div className="flex p-6" />

// lo que llega al navegador
<div className="_215464 _69df78" />`,
	},
	"native-piece": {
		lang: "tsx",
		code: `import { Box, Stack } from "native-piece";

<Stack gap="1rem" alignItems="center">
  <Box padding={20} borderRadius={8}>
    Sin provider, sin configuración.
  </Box>
</Stack>`,
	},
	"react-switch-casu": {
		lang: "jsx",
		code: `import Switch from "react-switch-casu";

<Switch expression={step}>
  <Switch.Case condition={1}><Login /></Switch.Case>
  <Switch.Case condition={2}><Register /></Switch.Case>
  <Switch.Default><Home /></Switch.Default>
</Switch>`,
	},
};

const rows = await Promise.all(
	packages.map(async (pkg) => ({pkg, downloads: await yearlyDownloads(pkg.name)})),
);
---

<ol class="divide-y divide-dashed divide-line border-y border-dashed border-line">
	{
		rows.map(({pkg, downloads}) => (
			<li class="grid gap-6 py-10 lg:grid-cols-12 lg:gap-10">
				<div class="lg:col-span-5">
					<p class="label mb-2">
						{pkg.year}
						{downloads !== null && <> · {formatNumber(downloads)} descargas el último año</>}
					</p>
					<h3 class="font-mono text-xl font-medium tracking-tight sm:text-2xl">{pkg.name}</h3>
					<p class="mt-2 font-display text-lg text-ink-soft italic">{pkg.line}</p>
					<p class="mt-4 leading-relaxed">{pkg.story}</p>
					<p class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
						{pkg.links?.map((link) => (
							<a class="ink-link" href={link.url} target="_blank" rel="noopener noreferrer">
								{link.label} <span aria-hidden="true">↗</span>
							</a>
						))}
					</p>
				</div>

				<div class="min-w-0 lg:col-span-7">
					<div class="rounded-[3px] border border-line bg-paper-deep/70 px-4 py-4 text-[0.82rem] leading-relaxed sm:px-5">
						<p class="label mb-3 select-all">
							<span class="text-accent select-none">$ </span>pnpm add {pkg.name === "tailwindcss-atomic" ? "-D " : ""}{pkg.name}
						</p>
						<Code
							code={snippets[pkg.name].code}
							lang={snippets[pkg.name].lang}
							themes={{light: "vitesse-light", dark: "vitesse-dark"}}
							defaultColor={false}
							class="!bg-transparent overflow-x-auto"
						/>
					</div>
				</div>
			</li>
		))
	}
</ol>

<style is:global>
	/* Shiki con dos temas: cada token trae ambos colores y aquí elegimos. */
	.astro-code,
	.astro-code span {
		color: var(--shiki-light);
		background-color: transparent !important;
	}
	[data-theme="dark"] .astro-code,
	[data-theme="dark"] .astro-code span {
		color: var(--shiki-dark);
	}
	.astro-code {
		font-family: var(--font-mono);
		tab-size: 2;
	}
</style>
