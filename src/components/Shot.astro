---
// Una captura en un marco limpio: una línea fina y una sombra suave.
// Solo el abanico de casinos la inclina, para que las cuatro marcas se vean.
import type {ImageMetadata} from "astro";
import {Image} from "astro:assets";

interface Props {
	src: ImageMetadata;
	alt: string;
	tilt?: number;
	phone?: boolean;
	sizes?: string;
	eager?: boolean;
	class?: string;
	style?: string;
}

const {
	src,
	alt,
	tilt = 0,
	phone = false,
	sizes = "(min-width: 1024px) 640px, 92vw",
	eager = false,
	class: className,
	style = "",
} = Astro.props;

const widths = phone ? [240, 360, 506] : [480, 800, 1200, 1440];
---

<figure class:list={["group/shot relative", className]} style={`--tilt: ${tilt}deg; ${style}`}>
	<div
		class:list={[
			"bg-print p-1 shadow-[0_1px_2px_var(--shadow),0_16px_32px_-14px_var(--shadow)] ring-1 ring-line transition-transform duration-500 ease-out",
			"rotate-(--tilt) group-hover/shot:-translate-y-1 motion-reduce:transition-none",
			phone ? "rounded-[1.1rem]" : "rounded-md",
		]}
	>
		<Image
			src={src}
			alt={alt}
			widths={widths}
			sizes={sizes}
			loading={eager ? "eager" : "lazy"}
			class:list={["block h-auto w-full", phone ? "rounded-[0.85rem]" : "rounded-[4px]"]}
		/>
	</div>
	<slot />
</figure>
