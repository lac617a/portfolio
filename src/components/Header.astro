---
import {me} from "../data/me";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
	{href: "/#trabajo", label: "Trabajo", wide: true},
	{href: "/proyectos", label: "Archivo", wide: false},
	{href: "/#taller", label: "Taller", wide: true},
	{href: "/#sobre-mi", label: "Sobre mí", wide: true},
	{href: "/#contacto", label: "Escríbeme", wide: false},
];
---

<header class="mx-auto flex w-full max-w-6xl items-baseline justify-between gap-4 px-4 pt-6 sm:px-6 sm:pt-8">
	<a href="/" class="group flex items-baseline gap-2" aria-label={`${me.name}, inicio`}>
		<span class="font-display text-xl italic tracking-tight sm:text-2xl" style="font-variation-settings: 'SOFT' 100, 'WONK' 1">
			Dominyel
		</span>
		<span class="label hidden transition-colors group-hover:text-accent sm:inline">@{me.handle}</span>
	</a>

	<nav aria-label="Principal">
		<ul class="flex items-baseline gap-4 text-sm sm:gap-6">
			{
				nav.map((item) => (
					<li class:list={[item.wide && "hidden md:block"]}>
						<a
							href={item.href}
							class:list={[
								"transition-colors hover:text-accent",
								path === item.href ? "text-accent" : "text-ink-soft",
							]}
							aria-current={path === item.href ? "page" : undefined}
						>
							{item.label}
						</a>
					</li>
				))
			}
			<li>
				<button
					type="button"
					data-theme-toggle
					class="label cursor-pointer rounded-sm border border-line px-2 py-1 transition-colors hover:border-ink-soft hover:text-ink"
				>
					<span class="dark:hidden">noche</span>
					<span class="hidden dark:inline">día</span>
					<span class="sr-only"> — cambiar tema</span>
				</button>
			</li>
		</ul>
	</nav>
</header>

<script>
	function bindToggle() {
		const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
		if (!button || button.dataset.bound) return;
		button.dataset.bound = "true";
		button.addEventListener("click", () => {
			const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
			document.documentElement.dataset.theme = next;
			try {
				localStorage.setItem("theme", next);
			} catch {}
		});
	}
	document.addEventListener("astro:page-load", bindToggle);
</script>
