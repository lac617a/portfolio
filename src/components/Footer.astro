---
import {me} from "../data/me";

const year = new Date().getFullYear();
---

<footer class="mx-auto mt-24 w-full max-w-6xl px-4 pb-10 sm:px-6">
	<div class="flex flex-col gap-3 border-t border-dashed border-line pt-6 text-sm text-ink-soft sm:flex-row sm:items-baseline sm:justify-between">
		<p>
			Hecho a mano con Astro y Tailwind, desde {me.country}. © {year}.
		</p>
		<p class="flex gap-4">
			<a class="ink-link" href={me.links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
			<a class="ink-link" href={me.links.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
			<a class="ink-link" href={me.links.npm} target="_blank" rel="noopener noreferrer">npm</a>
		</p>
	</div>
</footer>
