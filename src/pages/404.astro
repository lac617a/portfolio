---
import Base from "../layouts/Base.astro";
import Scribble from "../components/Scribble.astro";
---

<Base title="No está aquí · Dominyel Rivera">
	<section class="mx-auto max-w-6xl px-4 pt-24 pb-16 sm:px-6 sm:pt-32">
		<p class="label mb-6">404</p>
		<h1 class="max-w-[18ch] text-[clamp(2.1rem,5.6vw,4.2rem)] leading-[1.08] font-[360]">
			Esta página no existe, o la moví sin avisarle a nadie.
		</h1>
		<p class="mt-8 flex items-center gap-3 text-lg">
			<Scribble kind="arrow" class="h-7 w-12 text-accent" />
			<a class="ink-link" href="/">Volver al inicio</a>
			<span class="text-ink-soft">o</span>
			<a class="ink-link" href="/proyectos">ver el archivo</a>
		</p>
	</section>
</Base>
